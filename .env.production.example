## ─── Production Database Configuration ────────────────────────────────
# Update this with your actual AWS RDS PostgreSQL endpoint
DB_USER=postgres
DB_PASSWORD=your-secure-rds-password
DB_HOST=your-rds-database-instance.c123456789.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=churn_ltv_prod

## ─── Application Configuration ──────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=WARNING

## ─── Authentication Configuration ───────────────────────────────────
# Run `openssl rand -hex 32` to generate a strong random key in production
SECRET_KEY=generate_a_secure_hex_key_for_production_deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

## ─── CORS Configuration ─────────────────────────────────────────────
# Restrict this to your domain/dashboard URL in production
CORS_ORIGINS=http://your-ec2-public-ip:3000,http://your-domain.com

## ─── Redis Caching Configuration ────────────────────────────────────
# If you run Redis on EC2 or utilize Amazon ElastiCache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password
